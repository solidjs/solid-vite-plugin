{
  "name": "@solidjs/vite-plugin",
  "version": "3.0.0-next.55",
  "description": "solid-js integration plugin for Vite",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "virtual-modules.d.ts",
    "boundary-modules.d.ts"
  ],
  "main": "dist/esm/index.mjs",
  "types": "dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "default": "./dist/esm/index.mjs"
    },
    "./virtual-modules": {
      "types": "./virtual-modules.d.ts"
    },
    "./boundary-modules": {
      "types": "./boundary-modules.d.ts"
    }
  },
  "scripts": {
    "build": "rolldown -c && tsc --noEmit && tsc -p tsconfig.build.json",
    "dev": "rolldown -c -w",
    "prepublishOnly": "pnpm build",
    "release": "pnpm build && changeset publish",
    "check": "package-check",
    "test": "node scripts/test-examples.ts",
    "test:unit": "vitest run",
    "typecheck:examples": "node scripts/typecheck-examples.ts",
    "test:ecosystem": "node scripts/test-ecosystem.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solidjs/solid-vite-plugin.git"
  },
  "keywords": [
    "vite",
    "vite plugin",
    "vitejs",
    "vitejs plugin",
    "vite-plugin",
    "solid"
  ],
  "author": "Alexandre Mouton-Brady <amoutonbrady@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/solidjs/solid-vite-plugin/issues"
  },
  "homepage": "https://github.com/solidjs/solid-vite-plugin#readme",
  "dependencies": {
    "@ampproject/remapping": "^2.3.0",
    "@babel/core": "^7.23.3",
    "@solidjs/babel-plugin": "^2.0.0-rc.19",
    "@solidjs/compiler": "^2.0.0-rc.19",
    "@types/babel__core": "^7.20.4",
    "magic-string": "^0.30.21",
    "merge-anything": "^5.1.7",
    "vitefu": "^1.0.4"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@playwright/test": "^1.64.1",
    "@skypack/package-check": "^0.2.2",
    "@solidjs/diagnostics": "2.0.0-rc.19",
    "@solidjs/start-devtools": "^1.0.0-next.3",
    "@solidjs/web": "^2.0.0-rc.19",
    "@types/node": "^24.0.0",
    "prettier": "^3.1.0",
    "rolldown": "^1.2.16",
    "solid-js": "^2.0.0-rc.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@solidjs/start-devtools": "^1.0.0-next.2",
    "@solidjs/web": "^2.0.0-rc.19",
    "@testing-library/jest-dom": "^5.16.6 || ^5.17.0 || ^6.0.0 || ^7.0.0",
    "solid-js": "^2.0.0-rc.19",
    "vite": "^8.0.0 || ^9.0.0"
  },
  "peerDependenciesMeta": {
    "@solidjs/start-devtools": {
      "optional": true
    },
    "@testing-library/jest-dom": {
      "optional": true
    }
  },
  "packageManager": "pnpm@9.15.3"
}
